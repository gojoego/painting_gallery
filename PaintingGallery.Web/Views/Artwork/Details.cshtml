@model PaintingGallery.Data.Models.Artwork

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-12 col-lg-7">
            <img 
                src="@Model.ImageUrl" 
                alt="@Model.Title"
                class="img-fluid w-100"
            >
        </div>
        <div class="col-12 col-lg-5">
            <h1 class="display-6 fw-normal">
                @Model.Title
            </h1>

            <p class="text-muted mb-1">
                @Model.Medium
            </p>
            <p class="text-muted">
                @Model.Dimensions
            </p>
            <p class="fs-5">
                @Model.Price.ToString("C")
            </p>
            <p>
                @Model.Description
            </p>

            <a 
                asp-controller="Artwork"
                asp-action="Index"
                class="btn btn-outline-dark mt-3"
            >
                Back to Gallery
            </a>
        </div>
    </div>
</div>
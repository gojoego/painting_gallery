@model List<PaintingGallery.Data.Models.Artwork>

<div class="container py-5">
    <header class="gallery-header text-center mb-5">
        <h1 class="display-5 fw-normal">
            Gallery
        </h1>
        <p class="text-muted">
            Original paintings by Artist 
        </p>        
    </header>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">
                No artwork is currently available.
            </p>
        </div>        
    }
    else
    {
        <div class="row g-4">
            @foreach (var artwork in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="artwork-card">
                        <a
                            asp-controller="Artwork"
                            asp-action="Details"
                            asp-route-id="@artwork.Id"
                        >
                            <div class="artwork-image-wrapper">
                                <img 
                                    src="@artwork.ImageUrl" 
                                    alt="@artwork.Title"
                                    class="img-fluid artwork-image"
                                />
                            </div>        
                        </a>

                        <div>
                            <h2 class="h5 fw-normal mb-1">@artwork.Title</h2>
                            <p class="text-muted small mb-1">
                                @artwork.Medium
                            </p>
                            <p class="text-muted small mb-2">
                                @artwork.Dimensions
                            </p>
                            <p class="mb-0">
                                @artwork.Price.ToString("C")
                            </p>
                        </div>
                    </article>
                </div>
            }
        </div>        
    }
</div>


